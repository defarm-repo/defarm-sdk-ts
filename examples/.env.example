# Copy to examples/.env (or export in your shell) and fill in with YOUR test-environment
# values. The examples ship with zero credentials on purpose.
#   set -a; source examples/.env; set +a

# Gateway base URL. /auth/* lives at the root, /v1 is derived. Swapping this repoints everything.
# REQUIRED, no default: ask the DeFarm team for your test-environment host. Pointing at
# production (https://gateway.defarm.net) is an explicit decision — never a default.
DEFARM_GATEWAY=

# The producer (seals data). A workspace login on the environment above.
DEFARM_PRODUCER_EMAIL=
DEFARM_PRODUCER_PASSWORD=

# The recipient (e.g. a slaughterhouse buying the animal — opens what was sealed to it).
DEFARM_RECIPIENT_EMAIL=
DEFARM_RECIPIENT_PASSWORD=

# Partner ingestion API key (X-API-Key). Items land in the circuit bound to the key.
DEFARM_PARTNER_API_KEY=

# The circuit the sealed event is written into (the producer must own/belong to it).
DEFARM_CIRCUIT_ID=

# Set by running 02-ingest (or use any DFID your key can see).
DEFARM_DFID=
