{
  "name": "@defarm/sdk",
  "version": "0.2.1",
  "description": "DeFarm SDK \u2014 verifiable agri traceability with client-side sealing (blind envelopes). The DeFarm server never sees your keys or your sealed data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defarm-repo/defarm-sdk-ts.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "example:01": "tsx examples/01-setup-keys.ts",
    "example:02": "tsx examples/02-ingest.ts",
    "example:03": "tsx examples/03-seal.ts",
    "example:04": "tsx examples/04-open.ts",
    "example:05": "tsx examples/05-visibility.ts",
    "example:06": "tsx examples/06-verify.ts",
    "prepare": "npm run build",
    "docs": "typedoc"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "^1.6.1",
    "@hpke/core": "^1.7.1",
    "@hpke/dhkem-x25519": "^1.6.1",
    "@noble/ciphers": "^1.2.1",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.12",
    "typedoc": "^0.27.9",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "defarm",
    "traceability",
    "hpke",
    "sealed-field",
    "blind-envelope",
    "stellar",
    "agriculture"
  ],
  "bin": {
    "defarm": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
